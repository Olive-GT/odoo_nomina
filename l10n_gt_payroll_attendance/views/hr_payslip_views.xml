<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Recomendación de horas extra en el recibo, justo encima de la tabla donde
         se capturan. Solo informa: la captura sigue siendo manual. -->
    <record id="view_payslip_form_gt_overtime" model="ir.ui.view">
        <field name="name">hr.payslip.form.gt.overtime</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']" position="before">
                <div class="alert alert-info mb-2" role="status"
                     invisible="not l10n_gt_overtime_detected and not l10n_gt_overtime_captured">
                    <div>
                        <b>Horas extra según asistencia (recomendación):</b>
                        <field name="l10n_gt_overtime_detected" class="oe_inline mx-1" readonly="1"/> h
                        en <field name="l10n_gt_overtime_detected_days" class="oe_inline mx-1" readonly="1"/> día(s),
                        contra el horario
                        <field name="l10n_gt_overtime_calendar_id" class="oe_inline mx-1"
                               readonly="1" options="{'no_open': True}"/>.
                        Capturadas en este recibo:
                        <field name="l10n_gt_overtime_captured" class="oe_inline mx-1" readonly="1"/> h.
                        <button name="action_l10n_gt_view_attendances" type="object"
                                string="Ver asistencias" class="btn-link p-0 ms-2"/>
                    </div>
                    <div class="small text-muted">
                        No se suman solas: verifica que el horario del contrato sea la
                        jornada real y captura las horas que correspondan
                        (<i>Agregar una línea → Horas extra</i>, horas en Cantidad).
                    </div>
                    <details invisible="not l10n_gt_overtime_detected" class="mt-1">
                        <summary>Detalle por día</summary>
                        <field name="l10n_gt_overtime_detail" readonly="1" nolabel="1"/>
                    </details>
                </div>
            </xpath>
        </field>
    </record>

    <!-- En la lista de recibos (la del lote): revisar a todos de una vez. -->
    <record id="view_payslip_list_gt_overtime" model="ir.ui.view">
        <field name="name">hr.payslip.list.gt.overtime</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="l10n_gt_overtime_detected" optional="show" string="HE asistencia"
                       decoration-warning="l10n_gt_overtime_detected != l10n_gt_overtime_captured"/>
                <field name="l10n_gt_overtime_captured" optional="show" string="HE en recibo"/>
            </xpath>
        </field>
    </record>

</odoo>
