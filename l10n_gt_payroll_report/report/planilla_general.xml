<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- §6.2 Nómina de sueldos y salarios, con el formato que usa el cliente
         (mismas columnas que el Excel de l10n_gt_payroll_report_xlsx). Los datos
         salen de hr.payslip.run._l10n_gt_nomina_rows(). -->
    <template id="report_planilla">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.basic_layout">
                    <t t-set="cols" t-value="run.NOMINA_COLUMNS"/>
                    <t t-set="rows" t-value="run._l10n_gt_nomina_rows()"/>
                    <t t-set="totals" t-value="run._l10n_gt_nomina_totals(rows)"/>
                    <t t-set="th" t-value="'border:0.5px solid #999; padding:2px; text-align:center; vertical-align:middle;'"/>
                    <t t-set="td" t-value="'border:0.5px solid #ccc; padding:1px 2px;'"/>
                    <div class="page" style="font-family:Arial, sans-serif;">
                        <div style="text-align:center; margin-bottom:6px;">
                            <div style="font-size:14px;"><span t-esc="run.company_id.name"/></div>
                            <div style="font-size:9px;">NÓMINA DE SUELDOS Y SALARIOS</div>
                            <div style="font-size:9px;"><span t-esc="run._l10n_gt_nomina_period_label()"/></div>
                        </div>
                        <table style="width:100%; border-collapse:collapse; font-size:6.5px;">
                            <thead>
                                <tr style="background:#1F3864; color:#ffffff;">
                                    <th t-foreach="cols" t-as="c" t-att-style="th"><span t-esc="c[1]"/></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rows" t-as="r">
                                    <t t-foreach="cols" t-as="c">
                                        <t t-set="v" t-value="r[c[0]]"/>
                                        <td t-if="c[2]" t-att-style="td + 'text-align:right;'">
                                            <span t-if="v" t-esc="'{:,.2f}'.format(v)"/>
                                            <span t-elif="c[0] in ('total_horas_extra', 'primera_quincena')">-</span>
                                        </td>
                                        <td t-elif="c[0] == 'ingreso'" t-att-style="td + 'text-align:center;'">
                                            <span t-if="v" t-esc="v.strftime('%d/%m/%y')"/>
                                        </td>
                                        <td t-elif="c[0] == 'horas_extra'" t-att-style="td + 'text-align:right;'">
                                            <span t-if="v" t-esc="'{:,.2f}'.format(v)"/>
                                        </td>
                                        <td t-else="" t-att-style="td + ('text-align:right;' if c[0] == 'n' else '')">
                                            <span t-esc="v"/>
                                        </td>
                                    </t>
                                </tr>
                                <tr style="font-weight:bold;">
                                    <t t-foreach="cols" t-as="c">
                                        <td t-if="c[3]" style="border-top:1.5px double #000; background:#9BC2E6; padding:1px 2px; text-align:right;">
                                            <span t-esc="'{:,.2f}'.format(totals[c[0]])"/>
                                        </td>
                                        <td t-else=""/>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                        <table style="width:100%; margin-top:40px; border:none; font-size:8px;">
                            <tr>
                                <td style="width:15%; border:none;"/>
                                <td style="width:30%; border:none; text-align:center;">
                                    <div style="border-top:1px solid #000; padding-top:2px;">Elaborado por:</div>
                                    <div t-esc="run.company_id.l10n_gt_payroll_prepared_by or ''"/>
                                </td>
                                <td style="width:10%; border:none;"/>
                                <td style="width:30%; border:none; text-align:center;">
                                    <div style="border-top:1px solid #000; padding-top:2px;">Aprobado por:</div>
                                    <div t-esc="run.company_id.l10n_gt_payroll_approved_by or ''"/>
                                </td>
                                <td style="width:15%; border:none;"/>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
