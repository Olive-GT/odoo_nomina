<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- §6.8 Reporte de costos de personal -->
    <template id="report_costos">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family:Arial, sans-serif;">
                        <t t-call="l10n_gt_payroll_report.l10n_gt_report_header">
                            <t t-set="company" t-value="run.company_id"/>
                            <t t-set="r_title">COSTO DE PERSONAL PARA LA EMPRESA</t>
                            <t t-set="r_period" t-value="run._l10n_gt_period_label()"/>
                        </t>
                        <t t-set="rows" t-value="run._l10n_gt_costos_rows()"/>
                        <table style="width:100%; border-collapse:collapse; font-size:9px;">
                            <thead>
                                <tr style="background:#333333; color:#ffffff;">
                                    <th style="border:0.5px solid #999; padding:4px;">No.</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:left;">Empleado</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right;">Ordinario</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right;">Bonif. Inc.</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right;">H. Extra</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right;">Comisiones</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right;">IGSS patronal</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right;">IRTRA</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right;">INTECAP</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right; background:#555;">Costo total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="t_ord" t-value="0"/><t t-set="t_bon" t-value="0"/>
                                <t t-set="t_he" t-value="0"/><t t-set="t_com" t-value="0"/>
                                <t t-set="t_igss" t-value="0"/><t t-set="t_irt" t-value="0"/>
                                <t t-set="t_int" t-value="0"/><t t-set="t_tot" t-value="0"/>
                                <tr t-foreach="rows" t-as="r">
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:center;"><span t-esc="r_index + 1"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px;"><span t-esc="r['employee']"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(r['ordinario'])"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(r['bonif'])"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(r['he'])"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(r['comis'])"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(r['igss_pat'])"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(r['irtra'])"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(r['intecap'])"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right; font-weight:bold;"><span t-esc="run._l10n_gt_money(r['total'])"/></td>
                                    <t t-set="t_ord" t-value="t_ord + r['ordinario']"/>
                                    <t t-set="t_bon" t-value="t_bon + r['bonif']"/>
                                    <t t-set="t_he" t-value="t_he + r['he']"/>
                                    <t t-set="t_com" t-value="t_com + r['comis']"/>
                                    <t t-set="t_igss" t-value="t_igss + r['igss_pat']"/>
                                    <t t-set="t_irt" t-value="t_irt + r['irtra']"/>
                                    <t t-set="t_int" t-value="t_int + r['intecap']"/>
                                    <t t-set="t_tot" t-value="t_tot + r['total']"/>
                                </tr>
                                <tr style="background:#e6e6e6; font-weight:bold;">
                                    <td colspan="2" style="border:0.5px solid #999; padding:4px;">TOTALES</td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(t_ord)"/></td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(t_bon)"/></td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(t_he)"/></td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(t_com)"/></td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(t_igss)"/></td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(t_irt)"/></td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(t_int)"/></td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(t_tot)"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p style="font-size:8px; color:#555; margin-top:6px;">
                            El costo total incluye el salario del trabajador más la
                            cuota patronal (IGSS 10.67% + IRTRA 1% + INTECAP 1%).
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
