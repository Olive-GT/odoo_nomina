<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- §6.6 Reporte de IGSS -->
    <template id="report_igss">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family:Arial, sans-serif;">
                        <t t-call="l10n_gt_payroll_report.l10n_gt_report_header">
                            <t t-set="company" t-value="run.company_id"/>
                            <t t-set="r_title">REPORTE DE IGSS — CUOTAS LABORAL Y PATRONAL</t>
                            <t t-set="r_period" t-value="run._l10n_gt_period_label()"/>
                        </t>
                        <t t-set="rows" t-value="run._l10n_gt_igss_rows()"/>
                        <table style="width:100%; border-collapse:collapse; font-size:9px;">
                            <thead>
                                <tr style="background:#333333; color:#ffffff;">
                                    <th style="border:0.5px solid #999; padding:4px;">No.</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:left;">Empleado</th>
                                    <th style="border:0.5px solid #999; padding:4px;">Afiliación IGSS / DPI</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right;">Salario afecto</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right;">Cuota laboral (4.83%)</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right;">Cuota patronal (12.67%)</th>
                                    <th style="border:0.5px solid #999; padding:4px; text-align:right; background:#555;">Total por pagar</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="tb" t-value="0"/><t t-set="tl" t-value="0"/>
                                <t t-set="tp" t-value="0"/><t t-set="tt" t-value="0"/>
                                <tr t-foreach="rows" t-as="r">
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:center;"><span t-esc="r_index + 1"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px;"><span t-esc="r['employee']"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:center;"><span t-esc="r['affiliation'] or r['dpi']"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(r['base'])"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(r['laboral'])"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(r['patronal'])"/></td>
                                    <td style="border:0.5px solid #ccc; padding:4px; text-align:right; font-weight:bold;"><span t-esc="run._l10n_gt_money(r['total'])"/></td>
                                    <t t-set="tb" t-value="tb + r['base']"/>
                                    <t t-set="tl" t-value="tl + r['laboral']"/>
                                    <t t-set="tp" t-value="tp + r['patronal']"/>
                                    <t t-set="tt" t-value="tt + r['total']"/>
                                </tr>
                                <tr style="background:#e6e6e6; font-weight:bold;">
                                    <td colspan="3" style="border:0.5px solid #999; padding:4px;">TOTALES</td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(tb)"/></td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(tl)"/></td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(tp)"/></td>
                                    <td style="border:0.5px solid #999; padding:4px; text-align:right;"><span t-esc="run._l10n_gt_money(tt)"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p style="font-size:8px; color:#555; margin-top:6px;">
                            Base afecta = salario ordinario + horas extra + comisiones
                            (excluye Bonificación Incentivo). Sirve de apoyo para la
                            planilla presentada al IGSS.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
