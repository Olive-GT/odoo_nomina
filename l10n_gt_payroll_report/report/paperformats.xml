<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formato horizontal para los reportes de período anchos (planilla, libro,
         informe, costos, IGSS). Márgenes reducidos para que quepan las columnas. -->
    <record id="paperformat_gt_landscape" model="report.paperformat">
        <field name="name">GT Nómina — Horizontal</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">7</field>
        <field name="dpi">90</field>
    </record>

</odoo>
