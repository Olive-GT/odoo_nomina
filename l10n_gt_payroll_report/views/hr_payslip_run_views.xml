<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pagos en lote: una vez confirmada la nómina, se marca la quincena pagada
         para todos los recibos de una vez (en lugar de recibo por recibo). -->
    <record id="view_payslip_run_form_gt_pagos" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.gt.pagos</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="l10n_gt_q1_pending_count" invisible="1"/>
                <field name="l10n_gt_q2_pending_count" invisible="1"/>
                <field name="l10n_gt_no_schedule_count" invisible="1"/>
                <button name="action_gt_generar_pagos" type="object"
                        string="Generar programación de pagos" class="btn-secondary"
                        invisible="l10n_gt_state not in ('confirmed', 'posted', 'closed') or l10n_gt_no_schedule_count == 0"
                        groups="l10n_gt_payroll.group_payroll_user"/>
                <button name="action_gt_pay_quincena_1" type="object"
                        string="Marcar pagada 1ª quincena" class="btn-secondary"
                        invisible="l10n_gt_state not in ('confirmed', 'posted', 'closed') or l10n_gt_q1_pending_count == 0"
                        groups="l10n_gt_payroll.group_payroll_user"
                        confirm="Se marcará como PAGADA la primera quincena de todos los recibos pendientes del lote. ¿Continuar?"/>
                <button name="action_gt_pay_quincena_2" type="object"
                        string="Marcar pagada 2ª quincena" class="btn-secondary"
                        invisible="l10n_gt_state not in ('confirmed', 'posted', 'closed') or l10n_gt_q2_pending_count == 0"
                        groups="l10n_gt_payroll.group_payroll_user"
                        confirm="Se marcará como PAGADA la segunda quincena (o el pago del mes) de todos los recibos pendientes del lote. ¿Continuar?"/>
            </header>
        </field>
    </record>

</odoo>
