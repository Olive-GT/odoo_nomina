<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Firmas de la Nómina de sueldos y salarios (Excel y PDF). -->
    <record id="view_company_form_gt_payroll" model="ir.ui.view">
        <field name="name">res.company.form.gt.payroll</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Nómina GT" name="l10n_gt_payroll">
                    <group string="Firmas de la nómina de sueldos y salarios">
                        <field name="l10n_gt_payroll_prepared_by"/>
                        <field name="l10n_gt_payroll_approved_by"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
