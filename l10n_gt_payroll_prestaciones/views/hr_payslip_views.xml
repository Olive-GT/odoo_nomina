<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vacaciones del período en la pestaña de días, junto a 'Faltas' (misma
         lógica: solo se marcan las excepciones al 'trabajó todos los días').
         Aquí van el saldo y los días GOZADOS (descanso, sin efecto en dinero).
         Los días PAGADOS se capturan en la tabla de 'Cálculo del salario' (columna
         Cantidad de 'Vacaciones pagadas'), con el resto de conceptos en dinero;
         ambos bajan el mismo saldo. -->
    <record id="view_payslip_form_gt_vacation" model="ir.ui.view">
        <field name="name">hr.payslip.form.gt.vacation</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id"
               ref="l10n_gt_payroll_report.view_payslip_form_gt_quincena"/>
        <field name="arch" type="xml">
            <field name="l10n_gt_unpaid_days" position="after">
                <separator string="Vacaciones"/>
                <field name="l10n_gt_vacation_balance"/>
                <field name="l10n_gt_vacation_days"/>
                <field name="l10n_gt_vacation_paid_days" readonly="1"
                       invisible="not l10n_gt_vacation_paid_days"/>
                <div colspan="2" class="text-muted small">
                    Los <b>días gozados</b> son descanso pagado: no cambian el salario.
                    Si las vacaciones se <b>pagan en dinero</b>, agrega la línea
                    <b>Vacaciones pagadas</b> en <i>Cálculo del salario</i> con los días
                    en Cantidad. Ambos bajan el mismo saldo al confirmar el recibo.
                </div>
            </field>
        </field>
    </record>

</odoo>
