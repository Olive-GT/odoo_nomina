<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_poliza" model="ir.actions.report">
        <field name="name">Póliza contable de nómina</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_gt_payroll_account.report_poliza</field>
        <field name="report_file">l10n_gt_payroll_account.report_poliza</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_poliza">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-set="company" t-value="doc.company_id"/>
                    <div class="page" style="font-family:Arial, sans-serif;">
                        <div style="text-align:center; margin-bottom:8px;">
                            <div style="font-size:14px; font-weight:bold; text-transform:uppercase;"><span t-esc="company.name"/></div>
                            <div t-if="company.vat" style="font-size:9px; color:#333;">NIT: <span t-esc="company.vat"/></div>
                            <div style="font-size:12px; font-weight:bold; margin-top:2px;">PÓLIZA CONTABLE DE NÓMINA</div>
                            <div style="font-size:10px; color:#333;"><span t-esc="doc.name"/> — <span t-esc="doc._l10n_gt_period_label() if hasattr(doc, '_l10n_gt_period_label') else ''"/></div>
                        </div>
                        <t t-set="rows" t-value="doc._l10n_gt_poliza_data()"/>
                        <t t-set="total_debit" t-value="sum(r['debit'] for r in rows)"/>
                        <t t-set="total_credit" t-value="sum(r['credit'] for r in rows)"/>
                        <table style="width:100%; border-collapse:collapse; font-size:10px;">
                            <thead>
                                <tr style="background:#333333; color:#ffffff;">
                                    <th style="border:0.5px solid #999; padding:5px; text-align:left;">Cuenta contable</th>
                                    <th style="border:0.5px solid #999; padding:5px; text-align:right;">Debe</th>
                                    <th style="border:0.5px solid #999; padding:5px; text-align:right;">Haber</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rows" t-as="row">
                                    <td style="border:0.5px solid #ccc; padding:5px;"><span t-esc="row['name']"/></td>
                                    <td style="border:0.5px solid #ccc; padding:5px; text-align:right;"><span t-esc="'Q{:,.2f}'.format(row['debit']) if row['debit'] else ''"/></td>
                                    <td style="border:0.5px solid #ccc; padding:5px; text-align:right;"><span t-esc="'Q{:,.2f}'.format(row['credit']) if row['credit'] else ''"/></td>
                                </tr>
                                <tr style="background:#e6e6e6; font-weight:bold;">
                                    <td style="border:0.5px solid #999; padding:5px;">TOTALES</td>
                                    <td style="border:0.5px solid #999; padding:5px; text-align:right;"><span t-esc="'Q{:,.2f}'.format(total_debit)"/></td>
                                    <td style="border:0.5px solid #999; padding:5px; text-align:right;"><span t-esc="'Q{:,.2f}'.format(total_credit)"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p style="font-size:8px; color:#555; margin-top:8px;">
                            Cada concepto se registra como un par balanceado (gasto/pasivo).
                            El neto en "sueldos por pagar" corresponde al líquido a pagar a
                            los trabajadores. Póliza en borrador hasta su contabilización.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
